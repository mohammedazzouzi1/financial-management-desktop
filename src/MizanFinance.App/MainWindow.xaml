<ui:FluentWindow x:Class="MizanFinance.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:MizanFinance.App.ViewModels"
                 Title="Mizan Finance"
                 Width="1440" Height="900"
                 MinWidth="1100" MinHeight="700"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <ui:FluentWindow.Resources>
        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="12,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="14,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E3A8A" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#152A63" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Grid.Column="1" Title="Mizan Finance" />
        <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource MizanNavyBrush}" />

        <!-- Sidebar -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource MizanNavyBrush}"
                Width="{Binding IsPaneOpen, Converter={StaticResource BoolToSidebarWidthConverter}}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="16,16,16,24">
                    <StackPanel Visibility="{Binding IsPaneOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Mizan Finance" FontSize="18" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="Your finances. One clear view." FontSize="10" Foreground="#8496B4" Margin="0,2,0,8" />
                    </StackPanel>
                    <ui:Button Content="☰" Appearance="Transparent" Padding="8,4"
                               HorizontalAlignment="Right" VerticalAlignment="Top"
                               Command="{Binding TogglePaneCommand}" />
                </Grid>

                <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,20">
                    <Border Background="#152A63" CornerRadius="8" Padding="12" Margin="0,0,0,10"
                            Visibility="{Binding IsPaneOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentUserName}" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Text="{Binding CurrentUserRole}" Foreground="#8496B4" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <ui:Button Content="Déconnexion" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                               Command="{Binding LogoutCommand}" />
                </StackPanel>

                <StackPanel>
                    <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav"
                                 IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEqualsToBoolConverter}, ConverterParameter=Dashboard, Mode=OneWay}"
                                 Command="{Binding NavigateToCommand}" CommandParameter="{x:Static vm:AppPage.Dashboard}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" />
                            <TextBlock Text="  Tableau de bord" Visibility="{Binding IsPaneOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav"
                                 IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEqualsToBoolConverter}, ConverterParameter=Transactions, Mode=OneWay}"
                                 Command="{Binding NavigateToCommand}" CommandParameter="{x:Static vm:AppPage.Transactions}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💳" />
                            <TextBlock Text="  Transactions" Visibility="{Binding IsPaneOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav"
                                 IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEqualsToBoolConverter}, ConverterParameter=CashRegister, Mode=OneWay}"
                                 Command="{Binding NavigateToCommand}" CommandParameter="{x:Static vm:AppPage.CashRegister}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧾" />
                            <TextBlock Text="  Caisse" Visibility="{Binding IsPaneOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav"
                                 IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEqualsToBoolConverter}, ConverterParameter=BankAccounts, Mode=OneWay}"
                                 Command="{Binding NavigateToCommand}" CommandParameter="{x:Static vm:AppPage.BankAccounts}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏦" />
                            <TextBlock Text="  Comptes bancaires" Visibility="{Binding IsPaneOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav"
                                 IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEqualsToBoolConverter}, ConverterParameter=Settings, Mode=OneWay}"
                                 Command="{Binding NavigateToCommand}" CommandParameter="{x:Static vm:AppPage.Settings}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" />
                            <TextBlock Text="  Paramètres" Visibility="{Binding IsPaneOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource ApplicationBackgroundBrush}">
            <ContentControl Content="{Binding CurrentPageContent}" />
        </Border>
    </Grid>
</ui:FluentWindow>
