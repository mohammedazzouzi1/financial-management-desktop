<UserControl x:Class="MizanFinance.App.Views.TransactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Loaded="OnLoaded">
    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Transactions" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}">
                    <Run Text="{Binding TotalCount, Mode=OneWay}" />
                    <Run Text="transaction(s)" />
                </TextBlock>
            </StackPanel>
            <ui:Button Grid.Column="1" Content="+ Nouvelle transaction" Appearance="Primary"
                       Command="{Binding AddTransactionCommand}" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBox Grid.Column="0" Margin="0,0,10,0" PlaceholderText="Rechercher (référence, description, facture, chèque)..."
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <ComboBox Grid.Column="1" Margin="0,0,10,0" ItemsSource="{Binding Accounts}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedAccountFilter}" />

                <ComboBox Grid.Column="2" Margin="0,0,10,0" ItemsSource="{Binding TypeFilterOptions}"
                          SelectedItem="{Binding SelectedTypeFilter}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource TransactionTypeLabelConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <DatePicker Grid.Column="3" Margin="0,0,10,0" Width="130" SelectedDate="{Binding FromDate}" />
                <DatePicker Grid.Column="4" Margin="0,0,10,0" Width="130" SelectedDate="{Binding ToDate}" />

                <ui:Button Grid.Column="5" Content="Filtrer" Margin="0,0,8,0" Command="{Binding ApplyFiltersCommand}" />
                <ui:Button Grid.Column="6" Content="Réinitialiser" Command="{Binding ClearFiltersCommand}" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}" Padding="0">
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedTransaction}"
                      AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                      BorderThickness="0" RowHeight="44">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="100" />
                    <DataGridTemplateColumn Header="Type" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Type, Converter={StaticResource TransactionTypeLabelConverter}}" VerticalAlignment="Center" Margin="8,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Catégorie" Binding="{Binding Category.Name}" Width="140" />
                    <DataGridTextColumn Header="Compte" Binding="{Binding Account.Name}" Width="140" />
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                    <DataGridTemplateColumn Header="Paiement" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PaymentMethod, Converter={StaticResource PaymentMethodLabelConverter}}" VerticalAlignment="Center" Margin="8,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Montant" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Amount, Converter={StaticResource CurrencyConverter}}"
                                           HorizontalAlignment="Right" Margin="0,0,12,0" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsIncome}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource MizanSuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsExpense}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource MizanDangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Modifier" Margin="4,0" Padding="6,2" FontSize="11"
                                            Command="{Binding DataContext.EditTransactionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Suppr." Margin="4,0" Padding="6,2" FontSize="11"
                                            Command="{Binding DataContext.DeleteTransactionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
