<UserControl x:Class="MizanFinance.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24,32,32">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Paramètres" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Informations sur l'entreprise et préférences de l'application" Style="{StaticResource PageSubtitleStyle}" Margin="0,0,0,24" />

            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,20">
                <StackPanel DataContext="{Binding Settings}">
                    <TextBlock Text="Entreprise" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,16" />

                    <TextBlock Text="Nom de l'entreprise" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                    <TextBlock Text="Adresse" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                    <TextBlock Text="Téléphone" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                    <TextBlock Text="Email" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                    <TextBlock Text="Identifiant fiscal" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBox Text="{Binding TaxId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                    <TextBlock Text="Devise par défaut" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox ItemsSource="{Binding DataContext.AvailableCurrencies, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              SelectedItem="{Binding DefaultCurrency}" Width="180" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <ui:Button Content="Enregistrer les paramètres" Appearance="Primary" Command="{Binding SaveCommand}" Margin="0,0,10,0" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MizanSuccessBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource MizanDangerBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
