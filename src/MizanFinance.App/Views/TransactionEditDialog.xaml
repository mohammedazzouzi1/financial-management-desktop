<ui:FluentWindow x:Class="MizanFinance.App.Views.TransactionEditDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{Binding DialogTitle}"
                 Width="560" Height="700"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 ResizeMode="NoResize">
    <ui:FluentWindow.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style TargetType="ui:TextBox">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding DialogTitle}" ShowMaximize="False" ShowMinimize="False" />

        <ScrollViewer Grid.Row="1" Margin="24,0,24,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Date *" Style="{StaticResource FieldLabel}" />
                        <DatePicker SelectedDate="{Binding Date}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Type *" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding AvailableTypes}" SelectedItem="{Binding SelectedType}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource TransactionTypeLabelConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Montant *" Style="{StaticResource FieldLabel}" />
                <ui:NumberBox Value="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Compte *" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Accounts}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectedValue="{Binding AccountId}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Visibility="{Binding IsTransfer, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Compte destination *" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Accounts}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectedValue="{Binding TransferToAccountId}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Visibility="{Binding IsTransfer, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <TextBlock Text="Mode de paiement *" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding AvailablePaymentMethods}" SelectedItem="{Binding SelectedPaymentMethod}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource PaymentMethodLabelConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Catégorie" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding CategoryId}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Client" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Clients}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectedValue="{Binding ClientId}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Fournisseur" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Suppliers}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectedValue="{Binding SupplierId}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
                <ui:TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Référence" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="N° facture" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <StackPanel Visibility="{Binding ShowChequeField, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="N° chèque" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox Text="{Binding ChequeNumber, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" />
                <ui:TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60" TextWrapping="Wrap" />

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource MizanDangerBrush}" TextWrapping="Wrap"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" Margin="0,4,0,0" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,16,24,20">
            <ui:Button Content="Annuler" Margin="0,0,8,0" Command="{Binding CancelCommand}" />
            <ui:Button Content="Enregistrer" Appearance="Primary" Command="{Binding SaveCommand}"
                       IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
