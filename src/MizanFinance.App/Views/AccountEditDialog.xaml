<ui:FluentWindow x:Class="MizanFinance.App.Views.AccountEditDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{Binding DialogTitle}"
                 Width="480" Height="560"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 ResizeMode="NoResize">
    <ui:FluentWindow.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style TargetType="ui:TextBox">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding DialogTitle}" ShowMaximize="False" ShowMinimize="False" />

        <ScrollViewer Grid.Row="1" Margin="24,0,24,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Type de compte *" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding AvailableTypes}" SelectedItem="{Binding SelectedType}"
                          IsEnabled="{Binding IsEditMode, Converter={StaticResource InverseBooleanConverter}}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource AccountTypeLabelConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="Nom du compte *" Style="{StaticResource FieldLabel}" />
                <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Visibility="{Binding IsBankAccount, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Banque" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox Text="{Binding BankName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Numéro de compte" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox Text="{Binding AccountNumber, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="IBAN" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox Text="{Binding Iban, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <TextBlock Text="Devise *" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding AvailableCurrencies}" SelectedItem="{Binding SelectedCurrency}" />

                <TextBlock Text="Solde d'ouverture" Style="{StaticResource FieldLabel}" />
                <ui:NumberBox Value="{Binding OpeningBalance, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" />
                <ui:TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60" TextWrapping="Wrap" />

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource MizanDangerBrush}" TextWrapping="Wrap"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" Margin="0,4,0,0" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,16,24,20">
            <ui:Button Content="Annuler" Margin="0,0,8,0" Command="{Binding CancelCommand}" />
            <ui:Button Content="Enregistrer" Appearance="Primary" Command="{Binding SaveCommand}"
                       IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
