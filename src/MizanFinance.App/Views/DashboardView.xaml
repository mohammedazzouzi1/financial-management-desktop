<UserControl x:Class="MizanFinance.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24,32,32">
        <StackPanel>
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Tableau de bord" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Vue d'ensemble de votre trésorerie et de vos performances financières" Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
                <ComboBox Grid.Column="1" VerticalAlignment="Center" Width="180"
                          ItemsSource="{Binding AvailablePresets}" SelectedItem="{Binding SelectedPreset}" />
            </Grid>

            <UniformGrid Columns="3" Rows="2" Margin="0,0,0,24">
                <Border Style="{StaticResource KpiCardStyle}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="SOLDE CAISSE" Style="{StaticResource KpiLabelStyle}" />
                        <TextBlock Text="{Binding Summary.CurrentCashBalance, Converter={StaticResource CurrencyConverter}}" Style="{StaticResource KpiValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="SOLDE BANCAIRE" Style="{StaticResource KpiLabelStyle}" />
                        <TextBlock Text="{Binding Summary.TotalBankBalance, Converter={StaticResource CurrencyConverter}}" Style="{StaticResource KpiValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="TRÉSORERIE TOTALE" Style="{StaticResource KpiLabelStyle}" />
                        <TextBlock Text="{Binding Summary.TotalBalance, Converter={StaticResource CurrencyConverter}}" Style="{StaticResource KpiValueStyle}" Foreground="{StaticResource MizanAccentBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource KpiCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="REVENUS DU JOUR" Style="{StaticResource KpiLabelStyle}" />
                        <TextBlock Text="{Binding Summary.TodayRevenue, Converter={StaticResource CurrencyConverter}}" Style="{StaticResource KpiValueStyle}" Foreground="{StaticResource MizanSuccessBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="DÉPENSES DU JOUR" Style="{StaticResource KpiLabelStyle}" />
                        <TextBlock Text="{Binding Summary.TodayExpenses, Converter={StaticResource CurrencyConverter}}" Style="{StaticResource KpiValueStyle}" Foreground="{StaticResource MizanDangerBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <TextBlock Text="BÉNÉFICE DU MOIS" Style="{StaticResource KpiLabelStyle}" />
                        <TextBlock Text="{Binding Summary.MonthlyProfit, Converter={StaticResource CurrencyConverter}}" Style="{StaticResource KpiValueStyle}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Revenus vs Dépenses" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,16" />
                        <lvc:CartesianChart Series="{Binding RevenueExpenseSeries}" XAxes="{Binding RevenueExpenseXAxes}" Height="260" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource SectionCardStyle}" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Évolution de la trésorerie" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,16" />
                        <lvc:CartesianChart Series="{Binding CashFlowSeries}" XAxes="{Binding CashFlowXAxes}" Height="260" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
