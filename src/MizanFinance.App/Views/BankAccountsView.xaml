<UserControl x:Class="MizanFinance.App.Views.BankAccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Loaded="OnLoaded">
    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Comptes bancaires" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Gérez vos comptes et suivez l'évolution de leur solde" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <ui:Button Grid.Column="1" Content="Nouvelle opération" Margin="0,0,10,0" Command="{Binding NewOperationCommand}" VerticalAlignment="Center" />
            <ui:Button Grid.Column="2" Content="+ Nouveau compte" Appearance="Primary" Command="{Binding AddAccountCommand}" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}" Margin="0,0,12,0" Padding="0">
                <ListBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                         BorderThickness="0" Background="Transparent" Padding="8">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14,12" Margin="0,4" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Grid.Column="1" Text="Inactif" FontSize="11" Foreground="{StaticResource MizanDangerBrush}"
                                                   Visibility="{Binding IsActive, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding BankName}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,8" />
                                    <TextBlock Text="{Binding CurrentBalance, Converter={StaticResource CurrencyConverter}}" FontSize="18" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Modifier" FontSize="11" Padding="6,2" Margin="0,0,6,0"
                                                Command="{Binding DataContext.EditAccountCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Activer/Désactiver" FontSize="11" Padding="6,2"
                                                Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource SectionCardStyle}" Margin="12,0,0,0">
                <StackPanel>
                    <TextBlock Text="Évolution du solde (60 derniers jours)" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,16" />
                    <lvc:CartesianChart Series="{Binding BalanceSeries}" XAxes="{Binding BalanceXAxes}" Height="360" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
