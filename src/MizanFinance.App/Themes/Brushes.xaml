<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="MizanAccentColor">#2563EB</Color>
    <Color x:Key="MizanAccentColorDark">#1D4ED8</Color>
    <Color x:Key="MizanAccentColorLight">#DBEAFE</Color>
    <Color x:Key="MizanSuccessColor">#16A34A</Color>
    <Color x:Key="MizanSuccessColorLight">#DCFCE7</Color>
    <Color x:Key="MizanDangerColor">#DC2626</Color>
    <Color x:Key="MizanDangerColorLight">#FEE2E2</Color>
    <Color x:Key="MizanWarningColor">#D97706</Color>
    <Color x:Key="MizanWarningColorLight">#FEF3C7</Color>
    <Color x:Key="MizanInfoColor">#0891B2</Color>
    <Color x:Key="MizanNavyColor">#0F172A</Color>

    <SolidColorBrush x:Key="MizanAccentBrush" Color="{StaticResource MizanAccentColor}" />
    <SolidColorBrush x:Key="MizanAccentBrushDark" Color="{StaticResource MizanAccentColorDark}" />
    <SolidColorBrush x:Key="MizanAccentBrushLight" Color="{StaticResource MizanAccentColorLight}" />
    <SolidColorBrush x:Key="MizanSuccessBrush" Color="{StaticResource MizanSuccessColor}" />
    <SolidColorBrush x:Key="MizanSuccessBrushLight" Color="{StaticResource MizanSuccessColorLight}" />
    <SolidColorBrush x:Key="MizanDangerBrush" Color="{StaticResource MizanDangerColor}" />
    <SolidColorBrush x:Key="MizanDangerBrushLight" Color="{StaticResource MizanDangerColorLight}" />
    <SolidColorBrush x:Key="MizanWarningBrush" Color="{StaticResource MizanWarningColor}" />
    <SolidColorBrush x:Key="MizanWarningBrushLight" Color="{StaticResource MizanWarningColorLight}" />
    <SolidColorBrush x:Key="MizanInfoBrush" Color="{StaticResource MizanInfoColor}" />
    <SolidColorBrush x:Key="MizanNavyBrush" Color="{StaticResource MizanNavyColor}" />

</ResourceDictionary>
